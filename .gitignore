var/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Configuration locale : elle porte votre adresse de contact réelle.
# Elle reste sur votre machine, elle n'a rien à faire dans le dépôt.
config/local.toml
config/*.local.toml

# Identifiants Google : ils donnent l'écriture sur votre Drive. Le jeton
# OAuth en est un aussi — il porte un refresh token réutilisable.
# Ils restent sur votre machine, leur chemin seul est configuration.
config/drive-service-account.json
config/drive-credentials.json
config/drive-token.json
*-token.json
config/*service-account*.json
*-credentials.json
